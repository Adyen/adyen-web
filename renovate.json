{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", ":disableDependencyDashboard", "helpers:pinGitHubActionDigests"],
    "labels": ["dependencies"],
    "minimumReleaseAge": "21 days",
    "internalChecksFilter": "strict",
    "rebaseWhen": "behind-base-branch",
    "prConcurrentLimit": 5,
    "updateNotScheduled": false,
    "ignorePaths": ["packages/playground/**"],
    "packageRules": [
        {
            "matchDatasources": ["npm"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "Minor and Patch Updates"
        },
        {
            "matchPackageNames": ["@adyen/**", "cheerio"],
            "enabled": false
        },
        {
            "description": "Disable node-version updates",
            "matchDatasources": ["node-version"],
            "matchPackageNames": ["actions/node-versions"],
            "enabled": false
        },
        {
            "matchPackageNames": ["preact", "@swc/core", "@playwright/test", "sass"],
            "groupName": null
        },
        {
            "description": "TypeScript 7.0 ships as a native Go port without an in-process JavaScript compiler API, breaking ts-jest, typescript-eslint, and ts-loader. Lift this restriction once TypeScript 7.1+ restores a JavaScript API and downstream tooling adds support. Ref: https://devblogs.microsoft.com/typescript/announcing-typescript-7-0/#running-side-by-side-with-typescript-6.0",
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<7"
        },
        {
            "description": "Group example folder dependencies monthly on the first day of the month",
            "groupName": "Examples Dependencies",
            "matchFileNames": ["examples/**"],
            "matchUpdateTypes": ["major", "minor", "patch"],
            "schedule": ["* 0-3 1 * *"]
        }
    ]
}
